{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lukas",
  "version": "0.1.0",
  "identifier": "dev.lukas.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../frontend/app dev",
    "beforeBuildCommand": "pnpm --dir ../../frontend/app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lukas",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
